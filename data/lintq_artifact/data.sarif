{
  "$schema" : "https://json.schemastore.org/sarif-2.1.0.json",
  "version" : "2.1.0",
  "runs" : [ {
    "tool" : {
      "driver" : {
        "name" : "CodeQL",
        "organization" : "GitHub",
        "semanticVersion" : "2.11.2",
        "rules" : [ {
          "id" : "ql-init-without-transpilation",
          "name" : "ql-init-without-transpilation",
          "shortDescription" : {
            "text" : "Initialize without transpilation"
          },
          "fullDescription" : {
            "text" : "the circuit with initialize() instruction is directly run on a simulator backend without transpilation."
          },
          "defaultConfiguration" : {
            "enabled" : true,
            "level" : "error"
          },
          "properties" : {
            "tags" : [ "correctness", "reliability", "qiskit" ],
            "description" : "the circuit with initialize() instruction is directly run on a simulator backend\n without transpilation.",
            "id" : "ql-init-without-transpilation",
            "kind" : "problem",
            "name" : "Initialize without transpilation",
            "precision" : "medium",
            "problem.severity" : "error"
          }
        }, {
          "id" : "ql-meas-with-statevector",
          "name" : "ql-meas-with-statevector",
          "shortDescription" : {
            "text" : "Measurement in a circuit with statevector backend"
          },
          "fullDescription" : {
            "text" : "a circuit with measurement is run on a statevector backend and then the statevector is retrieved. This might lead to unexpected results in case because the measurement will distrupt the statevector and what is observed is only a possible outcome measreument."
          },
          "defaultConfiguration" : {
            "enabled" : true,
            "level" : "error"
          },
          "properties" : {
            "tags" : [ "correctness", "reliability", "qiskit" ],
            "description" : "a circuit with measurement is run on a statevector backend and then\n the statevector is retrieved. This might lead to unexpected results in case\n because the measurement will distrupt the statevector and what is observed is only\n a possible outcome measreument.",
            "id" : "ql-meas-with-statevector",
            "kind" : "problem",
            "name" : "Measurement in a circuit with statevector backend",
            "precision" : "medium",
            "problem.severity" : "error"
          }
        }, {
          "id" : "ql-deprecated-circuit-method",
          "name" : "ql-deprecated-circuit-method",
          "shortDescription" : {
            "text" : "Deprecated Circuit Method"
          },
          "fullDescription" : {
            "text" : "Check if the method call on the circuit is deprecated"
          },
          "defaultConfiguration" : {
            "enabled" : true,
            "level" : "error"
          },
          "properties" : {
            "tags" : [ "correctness", "reliability", "qiskit" ],
            "description" : "Check if the method call on the circuit is deprecated",
            "id" : "ql-deprecated-circuit-method",
            "kind" : "problem",
            "name" : "Deprecated Circuit Method",
            "precision" : "high",
            "problem.severity" : "error"
          }
        }, {
          "id" : "ql-deprecated-identity",
          "name" : "ql-deprecated-identity",
          "shortDescription" : {
            "text" : "Deprecated Identity"
          },
          "fullDescription" : {
            "text" : "Check if the deprecated iden() API is called instead of the identity()"
          },
          "defaultConfiguration" : {
            "enabled" : true,
            "level" : "error"
          },
          "properties" : {
            "tags" : [ "correctness", "reliability", "qiskit" ],
            "description" : "Check if the deprecated iden() API is called instead of the identity()",
            "id" : "ql-deprecated-identity",
            "kind" : "problem",
            "name" : "Deprecated Identity",
            "precision" : "high",
            "problem.severity" : "error"
          }
        }, {
          "id" : "ql-execute-with-seed",
          "name" : "ql-execute-with-seed",
          "shortDescription" : {
            "text" : "Execute with Seed"
          },
          "fullDescription" : {
            "text" : "execute API is called with a seed parameter that is ignored."
          },
          "defaultConfiguration" : {
            "enabled" : true,
            "level" : "error"
          },
          "properties" : {
            "tags" : [ "correctness", "reliability", "qiskit" ],
            "description" : "execute API is called with a seed parameter that is ignored.",
            "id" : "ql-execute-with-seed",
            "kind" : "problem",
            "name" : "Execute with Seed",
            "precision" : "high",
            "problem.severity" : "error"
          }
        }, {
          "id" : "ql-ghost-qasm-import",
          "name" : "ql-ghost-qasm-import",
          "shortDescription" : {
            "text" : "Ghost QASM import."
          },
          "fullDescription" : {
            "text" : "Check that the QuantumCircuit.from_qasm_str return value is assigned to a quantum circuit."
          },
          "defaultConfiguration" : {
            "enabled" : true,
            "level" : "error"
          },
          "properties" : {
            "tags" : [ "correctness", "reliability", "qiskit" ],
            "description" : "Check that the QuantumCircuit.from_qasm_str return value is assigned to a quantum circuit.",
            "id" : "ql-ghost-qasm-import",
            "kind" : "problem",
            "name" : "Ghost QASM import.",
            "precision" : "high",
            "problem.severity" : "error"
          }
        }, {
          "id" : "ql-improper-draw",
          "name" : "ql-improper-draw",
          "shortDescription" : {
            "text" : "ImproperDraw."
          },
          "fullDescription" : {
            "text" : "The draw function does not return a string, but it has to be used as is: e.g. replace print(qc.draw(output='mpl')) with qc.draw(output='mlp')."
          },
          "defaultConfiguration" : {
            "enabled" : true,
            "level" : "error"
          },
          "properties" : {
            "tags" : [ "correctness", "reliability", "qiskit" ],
            "description" : "The draw function does not return a string, but it has to be used as is: e.g. replace print(qc.draw(output='mpl')) with qc.draw(output='mlp').",
            "id" : "ql-improper-draw",
            "kind" : "problem",
            "name" : "ImproperDraw.",
            "precision" : "high",
            "problem.severity" : "error"
          }
        }, {
          "id" : "ql-multiple_submission",
          "name" : "ql-multiple_submission",
          "shortDescription" : {
            "text" : "Multiple Submission"
          },
          "fullDescription" : {
            "text" : "Backend is repeatedly called in a loop. Consider submitting parametrized circuits."
          },
          "defaultConfiguration" : {
            "enabled" : true,
            "level" : "error"
          },
          "properties" : {
            "tags" : [ "correctness", "reliability", "qiskit" ],
            "description" : "Backend is repeatedly called in a loop. Consider submitting parametrized circuits.",
            "id" : "ql-multiple_submission",
            "kind" : "problem",
            "name" : "Multiple Submission",
            "precision" : "high",
            "problem.severity" : "error"
          }
        }, {
          "id" : "ql-simulator-size-overflow",
          "name" : "ql-simulator-size-overflow",
          "shortDescription" : {
            "text" : "Simulator size overflow."
          },
          "fullDescription" : {
            "text" : "Check if the circuit is larger than the supported simulator (e.g. Aer.get_backend(’qasm_simulator’) supports max 30 qubits, BasicAer.get_backend(’qasm_simulator’) supports max 24 qubits)"
          },
          "defaultConfiguration" : {
            "enabled" : true,
            "level" : "error"
          },
          "properties" : {
            "tags" : [ "correctness", "reliability", "qiskit" ],
            "description" : "Check if the circuit is larger than the supported simulator (e.g.  Aer.get_backend(’qasm_simulator’) supports max 30 qubits,  BasicAer.get_backend(’qasm_simulator’) supports max 24 qubits)",
            "id" : "ql-simulator-size-overflow",
            "kind" : "problem",
            "name" : "Simulator size overflow.",
            "precision" : "high",
            "problem.severity" : "error"
          }
        }, {
          "id" : "ql-superfluous-op",
          "name" : "ql-superfluous-op",
          "shortDescription" : {
            "text" : "Superfluous operation."
          },
          "fullDescription" : {
            "text" : "gates on qubits that are not measured or that do not affect other qubits which are measured."
          },
          "defaultConfiguration" : {
            "enabled" : true,
            "level" : "error"
          },
          "properties" : {
            "tags" : [ "correctness", "reliability", "qiskit" ],
            "description" : "gates on qubits that are not measured or that do not affect other qubits\n which are measured.",
            "id" : "ql-superfluous-op",
            "kind" : "problem",
            "name" : "Superfluous operation.",
            "precision" : "high",
            "problem.severity" : "error"
          }
        }, {
          "id" : "ql-superfluous-op-precise",
          "name" : "ql-superfluous-op-precise",
          "shortDescription" : {
            "text" : "Superfluous operation (extra precision)"
          },
          "fullDescription" : {
            "text" : "gates on qubits that are not measured or that do not affect other qubits which are measured."
          },
          "defaultConfiguration" : {
            "enabled" : true,
            "level" : "error"
          },
          "properties" : {
            "tags" : [ "correctness", "reliability", "qiskit" ],
            "description" : "gates on qubits that are not measured or that do not affect other qubits\n which are measured.",
            "id" : "ql-superfluous-op-precise",
            "kind" : "problem",
            "name" : "Superfluous operation (extra precision)",
            "precision" : "high",
            "problem.severity" : "error"
          }
        }, {
          "id" : "ql-ghost-composition",
          "name" : "ql-ghost-composition",
          "shortDescription" : {
            "text" : "Ghost Composition."
          },
          "fullDescription" : {
            "text" : "when two circuits are composed but the inplace=True is not used and the return value of the compose() method is not store, then the composed circuit is lost."
          },
          "defaultConfiguration" : {
            "enabled" : true,
            "level" : "error"
          },
          "properties" : {
            "tags" : [ "correctness", "reliability", "qiskit" ],
            "description" : "when two circuits are composed but the inplace=True is not used\n and the return value of the compose() method is not store, then the\n composed circuit is lost.",
            "id" : "ql-ghost-composition",
            "kind" : "problem",
            "name" : "Ghost Composition.",
            "precision" : "high",
            "problem.severity" : "error"
          }
        }, {
          "id" : "ql-ghost-from-qasm",
          "name" : "ql-ghost-from-qasm",
          "shortDescription" : {
            "text" : "Ghost from qasm"
          },
          "fullDescription" : {
            "text" : "when a circuit is created from a qasm string and the return value of the from_qasm_str() method is not store, then the circuit is not used"
          },
          "defaultConfiguration" : {
            "enabled" : true,
            "level" : "error"
          },
          "properties" : {
            "tags" : [ "correctness", "reliability", "qiskit" ],
            "description" : "when a circuit is created from a qasm string\n and the return value of the from_qasm_str() method is not store, then the\n circuit is not used",
            "id" : "ql-ghost-from-qasm",
            "kind" : "problem",
            "name" : "Ghost from qasm",
            "precision" : "high",
            "problem.severity" : "error"
          }
        }, {
          "id" : "ql-incompatible-composition",
          "name" : "ql-incompatible-composition",
          "shortDescription" : {
            "text" : "Incompatible Composition."
          },
          "fullDescription" : {
            "text" : "when two circuits are composed, the number of qubits of the sub circuit must be lower thanthe number of qubits of the main circuit, otherwise the composition is not possible. Same for the number of bits. Another option is to specify how the two wires should be connected."
          },
          "defaultConfiguration" : {
            "enabled" : true,
            "level" : "error"
          },
          "properties" : {
            "tags" : [ "correctness", "reliability", "qiskit" ],
            "description" : "when two circuits are composed, the number of qubits of the\n sub circuit must be lower thanthe number of qubits of the main circuit,\n otherwise the composition is not possible. Same for the number of bits.\n Another option is to specify how the two wires should be connected.",
            "id" : "ql-incompatible-composition",
            "kind" : "problem",
            "name" : "Incompatible Composition.",
            "precision" : "high",
            "problem.severity" : "error"
          }
        }, {
          "id" : "ql-ungoverned-composition",
          "name" : "ql-ungoverned-composition",
          "shortDescription" : {
            "text" : "Ungoverned Composition."
          },
          "fullDescription" : {
            "text" : "when two circuits are composed the wires of the two circuits are connected in a way that is not specified in code but is left to Qiskit based on its defualt. This can lead to unexpected results."
          },
          "defaultConfiguration" : {
            "enabled" : true,
            "level" : "warning"
          },
          "properties" : {
            "tags" : [ "maintainability", "recommendation", "qiskit" ],
            "description" : "when two circuits are composed the wires of the two circuits\n are connected in a way that is not specified in code but is left to Qiskit\n based on its defualt. This can lead to unexpected results.",
            "id" : "ql-ungoverned-composition",
            "kind" : "problem",
            "name" : "Ungoverned Composition.",
            "precision" : "high",
            "problem.severity" : "warning"
          }
        }, {

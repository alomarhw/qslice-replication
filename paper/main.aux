\@writefile{lof}{\contentsline {figure}{\numberline {5}{\ignorespaces Share of pairs whose slice, computed at $\lvert 0\dots  0\rangle $, stays correct in all 100{} draws of each input regime, for RQ2. Commutation is shown on the 732{} pairs where Qiskit's pass applies, state-based pruning on the 477{} pairs it prunes, and angle rebinding on the pairs of circuits with rotation angles.}}{11}{}\protected@file@percent }
\newlabel{fig:robust}{{5}{11}{}{figure.5}{}}
